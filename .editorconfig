# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# JavaScript, TypeScript, and JSON specific overrides
[*.{js,jsx,ts,tsx,mjs,cjs,json}]
indent_style = space
indent_size = 2

# Keep trailing whitespace in Markdown files (for line breaks)
[*.md]
trim_trailing_whitespace = false
